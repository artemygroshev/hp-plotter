      "html": "<button class=\"ds-button-quiet\" type=\"button\">Светлая тема</button>",
      "css": ".ds-button-quiet{font-family:Plex,system-ui,sans-serif;font-size:1rem;line-height:1.4;min-height:44px;border:1px solid var(--line,#3c5363);border-radius:7px;padding:9px 15px;color:var(--text,#e9f0f6);cursor:pointer;display:inline-flex;gap:9px;align-items:center;justify-content:center;font-variant-numeric:tabular-nums;transition:background-color 140ms ease-out;background:transparent;}.ds-button-quiet:hover{background:var(--line,#3c5363);}.ds-button-quiet:focus-visible{outline:3px solid var(--focus,#bce7ff);outline-offset:4px;}.ds-button-quiet:active{transform:translateY(1px)}.ds-button-quiet:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-quiet{transition:none}}"
