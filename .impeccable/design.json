      "css": ".ds-badge-warning{font-family:Plex,system-ui,sans-serif;display:inline-flex;gap:7px;align-items:center;padding:4px 9px;min-height:28px;border-radius:5px;background:var(--warning-bg,#383329);color:var(--warning,#f2d39a);font-size:.875rem;line-height:1.5;white-space:normal;flex-shrink:0;max-width:50%;font-variant-numeric:tabular-nums}@media(forced-colors:active){.ds-badge-warning{border:1px solid CanvasText}}"
