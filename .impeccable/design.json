      "css": ".ds-lcd-frame{font-family:Plex,system-ui,sans-serif;margin:18px 0 12px;padding:18px;border-radius:8px;background:var(--lcd,#d5e3ca);color:var(--lcd-text,#273d31);line-height:1.5}.ds-lcd-empty{margin:0;color:var(--lcd-muted,#3f5747);padding:30px 0;font-size:.875rem;max-width:72ch;overflow-wrap:anywhere}"
    },
    {
      "name": "File Drop Target",
      "kind": "custom",
      "description": "A dashed upload region that keeps the native file selector available.",
      "html": "<label class=\"ds-file-drop\">Выберите или перетащите файл<span class=\"ds-file-hint\">PDF, PNG, JPEG · до 25 МиБ</span><input class=\"ds-file-input\" type=\"file\" accept=\".pdf,.png,.jpg,.jpeg\"></label>",
      "css": ".ds-file-drop{font-family:Plex,system-ui,sans-serif;border:1px dashed var(--line,#3c5363);border-radius:8px;padding:18px 18px 15px;display:flex;flex-direction:column;gap:5px;align-items:start;cursor:pointer;color:var(--text,#e9f0f6);font-size:1rem;line-height:1.5}.ds-file-drop.ds-dragging{border-color:var(--accent,#8ecdf1);background:var(--raised,#213441)}.ds-file-hint{font-size:.875rem;color:var(--muted,#aabeca)}.ds-file-input{font-family:Plex,system-ui,sans-serif;max-width:100%;font-size:.875rem;line-height:1.5;color:var(--muted,#aabeca);margin-top:8px;min-height:34px}.ds-file-input::file-selector-button{border:1px solid var(--line,#3c5363);border-radius:5px;background:var(--raised,#213441);color:var(--text,#e9f0f6);font:inherit;padding:6px 10px;margin-right:10px;cursor:pointer}.ds-file-input:focus-visible{outline:3px solid var(--focus,#bce7ff);outline-offset:4px;}@media(max-width:680px){.ds-file-drop{padding:16px 13px}}"
    }
  ],
  "narrative": {
    "northStar": "The Engineering Workbench",
    "overview": "The panel retains its engineering identity: deep blue surfaces, a calm blue action accent, IBM Plex Sans, and familiar forms and tables. It is a browser interface for checking a plotter from a computer or phone. The visual language favors readable status, explicit actions, and compact technical detail.\n\nSource and freshness are part of the interface. The CUPS queue and saved HP readings occupy distinct containers with their own timestamps and status text. Diagnostic detail remains available through disclosures; an unknown reading stays unknown. The light theme uses the same hierarchy and component geometry.",
    "keyCharacteristics": [
      "Tonal blue surfaces with thin structural borders.",
      "IBM Plex Sans for Russian interface text and tabular numbers for operational data.",
      "Independent queue and snapshot status, expressed with words and semantic color.",
      "Intrinsic columns, text-aware navigation widths, and stacked phone layouts.",
      "Restrained state transitions and native browser controls."
    ],
    "rules": [
      {
        "name": "The Independent Status Rule",
        "body": "Queue success must never imply that the physical plotter is Ready. Keep each status beside its own source and timestamp.",
        "section": "colors"
      },
      {
        "name": "The Operational Numbers Rule",
        "body": "Buttons, badges, table cells, and definition-list values use tabular numerals so changing readings do not disturb alignment.",
        "section": "typography"
      },
      {
        "name": "The Text-Aware Layout Rule",
        "body": "Preserve rem-based navigation widths, shrinkable content tracks, wrapping text, and stacked mobile job actions when extending the panel.",
        "section": "layout"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Use the existing surface layers and borders for structural separation; do not add shadows to ordinary panels or controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep queue and saved HP status independently dated and explicitly labeled.",
      "**Do** use the semantic variable pairs for both themes and retain text labels beside status colors.",
      "**Do** preserve IBM Plex Sans, tabular operational numbers, and monospace literal reports.",
      "**Do** keep long file names and diagnostic values wrappable, with local overflow for technical tables.",
      "**Do** retain visible focus, native controls, reduced-motion behavior, and stacked phone job actions.",
      "**Do** state unavailable, stale, and uncertain results in the container that owns them."
    ],
    "donts": [
      "**Don't** equate an empty or completed CUPS queue with physical printer readiness or print quality.",
      "**Don't** present cached HP readings as a live physical poll or silently remove their age.",
      "**Don't** invent a hardware cause when the evidence identifies only a code or an electrical error category.",
      "**Don't** turn raw service values into ink percentages without a confirmed interpretation.",
      "**Don't** add ornamental shadows or replace labeled interface icons with font glyphs.",
      "**Don't** widen the page to fit a table, long value, or job action group."
    ]
  }
}
