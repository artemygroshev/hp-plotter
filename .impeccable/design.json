  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The Medium-weight file submission or confirmation action.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Проверить и отправить</button>",
      "css": ".ds-button-primary{font-family:Plex,system-ui,sans-serif;font-size:1rem;line-height:1.4;min-height:44px;border:1px solid var(--line,#3c5363);border-radius:7px;padding:9px 15px;color:var(--text,#e9f0f6);cursor:pointer;display:inline-flex;gap:9px;align-items:center;justify-content:center;font-variant-numeric:tabular-nums;transition:background-color 140ms ease-out;background:var(--accent,#8ecdf1);border-color:var(--accent,#8ecdf1);color:var(--accent-text,#102d42);font-weight:500;}.ds-button-primary:hover:not(:disabled){filter:brightness(1.08);}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#bce7ff);outline-offset:4px;}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}@media(forced-colors:active){.ds-button-primary{border:2px solid ButtonText}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A raised utility action such as refreshing the panel.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 8a8 8 0 1 0 0 8M20 3v5h-5\"/></svg>Обновить панель</button>",
      "css": ".ds-button-secondary{font-family:Plex,system-ui,sans-serif;font-size:1rem;line-height:1.4;min-height:44px;border:1px solid var(--line,#3c5363);border-radius:7px;padding:9px 15px;color:var(--text,#e9f0f6);cursor:pointer;display:inline-flex;gap:9px;align-items:center;justify-content:center;font-variant-numeric:tabular-nums;transition:background-color 140ms ease-out;background:var(--raised,#213441);}.ds-button-secondary:hover{background:var(--line,#3c5363);}.ds-button-secondary:focus-visible{outline:3px solid var(--focus,#bce7ff);outline-offset:4px;}.ds-button-secondary:active{transform:translateY(1px)}.ds-button-secondary:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}.ds-button-secondary svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}"
    },
