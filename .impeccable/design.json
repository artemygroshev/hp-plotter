    {
      "name": "Labeled Input",
      "kind": "input",
      "refersTo": "input",
      "description": "A grounded field with a visible label, helper text, and keyboard focus.",
      "html": "<label class=\"ds-field\">Длина листа, мм<input class=\"ds-input\" type=\"number\" min=\"80\" max=\"2000\" step=\"1\" value=\"430\"><span class=\"ds-help\">Ширина фиксирована: 610 мм</span></label>",
      "css": ".ds-field{font-family:Plex,system-ui,sans-serif;display:grid;gap:7px;font-size:.875rem;line-height:1.5;color:var(--text,#e9f0f6)}.ds-input{font-family:Plex,system-ui,sans-serif;background:var(--ground,#101820);color:var(--text,#e9f0f6);border:1px solid var(--line,#3c5363);border-radius:6px;min-width:0;width:100%;min-height:44px;padding:9px 11px;font-size:1rem;line-height:1.5}.ds-input:focus-visible{outline:3px solid var(--focus,#bce7ff);outline-offset:4px;}.ds-help{color:var(--muted,#aabeca)}"
    },
    {
      "name": "Current Navigation Link",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Labeled section navigation with an explicit current state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Разделы плоттера\"><a class=\"ds-nav-link\" href=\"#overview\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z\"/></svg>Обзор</a></nav>",
      "css": ".ds-nav{display:grid;gap:7px}.ds-nav-link{font-family:Plex,system-ui,sans-serif;display:flex;gap:12px;align-items:center;min-height:48px;padding:10px;border-radius:7px;text-decoration:none;color:var(--muted,#aabeca);font-size:1rem;line-height:1.5;font-weight:500}.ds-nav-link:hover{color:var(--text,#e9f0f6);background:var(--raised,#213441)}.ds-nav-link[aria-current]{color:var(--accent,#8ecdf1);background:var(--raised,#213441)}.ds-nav-link:focus-visible{outline:3px solid var(--focus,#bce7ff);outline-offset:4px;}.ds-nav-link svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}@media(max-width:680px){.ds-nav{display:flex;overflow:auto;gap:5px;padding:3px 0}.ds-nav-link{white-space:nowrap;min-height:42px;padding:8px 10px;font-size:.875rem}.ds-nav-link svg{width:18px;height:18px}}"
    },
