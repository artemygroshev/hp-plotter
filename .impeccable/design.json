      "html": "<p class=\"ds-notice-danger\" role=\"status\">Текущее состояние очереди не подтверждено. Обновите панель.</p>",
      "css": ".ds-notice-danger{font-family:Plex,system-ui,sans-serif;margin:0;font-size:.875rem;padding:12px 14px;border-radius:6px;line-height:1.5;max-width:none;overflow-wrap:anywhere;background:var(--danger-bg,#422c32);color:var(--danger,#ffb5b5)}@media(forced-colors:active){.ds-notice-danger{border:1px solid CanvasText}}"
    },
    {
      "name": "Data Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "The flat, bordered container shared by queue, snapshot, and diagnostic sections.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">Журнал ошибок HP</h2><p class=\"ds-panel-note\">Сохранённые события плоттера. Их даты неизвестны.</p></section>",
      "css": ".ds-panel{font-family:Plex,system-ui,sans-serif;background:var(--surface,#192733);color:var(--text,#e9f0f6);border:1px solid var(--line,#3c5363);border-radius:12px;padding:24px;min-width:0;line-height:1.5}.ds-panel-title{margin:0;font-size:1.3rem;font-weight:500;line-height:1.35}.ds-panel-note{margin:6px 0 0;font-size:.875rem;color:var(--muted,#aabeca);max-width:72ch;overflow-wrap:anywhere}@media(max-width:680px){.ds-panel{padding:19px 17px}}"
    },
